# BrewTrace Platform — Secure Environment Template
# Copy to .env (and .env.local) and fill in the values. Never commit real keys.

# ---------------------------------------------------------------------------
# API / Backend
# ---------------------------------------------------------------------------
# Base URL of the backend/adapter that the SPA proxies. Must be a trusted
# same-origin origin in production (see server/index.cjs has no fetch proxy).
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Payment Gateway (3D card checkout)
# ---------------------------------------------------------------------------
# Sandbox key used by the checkout gateway during local development and
# automated audits. Rotate this key before any production traffic.
PAYMENT_GATEWAY_SANDBOX_KEY=

# ---------------------------------------------------------------------------
# Client-side security
# ---------------------------------------------------------------------------
# HMAC/RC4 seed used to derive per-session card-field encryption keys on
# the client. Keep this salt out of source control and CI logs.
VITE_SECURITY_SALT=
